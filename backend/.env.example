# YakinLulus.id — Environment Variables
# Copy to .env.local and fill in values

# Supabase / PostgreSQL
DB_URL=postgresql://postgres:password@db.cjrhqywtwlmebthajrkx.supabase.co:5432/postgres?sslmode=require&connect_timeout=10

# Redis (optional — server starts without it)
